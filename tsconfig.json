{
  "compilerOptions": {
    
    "target": "es6",
    "lib": [
      "DOM",
      "ES2022"
    ],
    "rootDir": "src",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "declaration": true,
    "outDir": "./dist",
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["./node_modules/@types", "./homebridge-lib.d.ts"]
  },
  "include": [
    "src/**/*.ts",
    "eslint.config.js",
    "homebridge-ui",
    "src"
  ],
  "exclude": [
    "node_modules"
  ]
}
